# Provedor de IA (Google Gemini)
GEMINI_API_KEY=
GEMINI_BULK_MODEL=gemini-3.5-flash-lite
GEMINI_QUALITY_MODEL=gemini-3.6-flash
GEMINI_BULK_THINKING_LEVEL=minimal
GEMINI_QUALITY_THINKING_LEVEL=low

# Limites e tempo de espera
AI_REQUEST_TIMEOUT_MS=240000
AI_MAX_COMPLETION_TOKENS=3000
AI_MAX_REQUEST_BYTES=12000000
AI_MAX_CONTEXT_CHARS=10000000
NEXT_PUBLIC_MAX_FILE_MB=25
NEXT_PUBLIC_MAX_CONTEXT_CHARS=10000000
NEXT_PUBLIC_AI_CHUNK_CHARS=20000
