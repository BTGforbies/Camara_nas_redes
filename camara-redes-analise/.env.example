# Provedor de IA (Groq Cloud)
GROQ_API_KEY=
GROQ_MODEL=groq/compound

# Limites e tempo de espera
AI_REQUEST_TIMEOUT_MS=240000
AI_MAX_COMPLETION_TOKENS=3000
AI_MAX_REQUEST_BYTES=12000000
AI_MAX_CONTEXT_CHARS=2000000
NEXT_PUBLIC_MAX_FILE_MB=25
NEXT_PUBLIC_MAX_CONTEXT_CHARS=2000000
NEXT_PUBLIC_AI_CHUNK_CHARS=60000
